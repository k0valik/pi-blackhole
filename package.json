{
  "name": "pi-blackhole",
  "version": "0.4.9",
  "packageManager": "pnpm@11.2.2",
  "description": "Unified compaction + observational memory extension for Pi — compresses conversation context while preserving durable observations and reflections",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "*.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!tests/",
    "tsup.config.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/CHANGELOG.md",
    "example-config.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint",
    "prepare": "node scripts/prepare.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "pi-agent",
    "pi-blackhole",
    "blackhole",
    "compact",
    "compaction",
    "observational-memory",
    "recall",
    "ai",
    "agents",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0valik/pi-blackhole.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-ai": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.81.1 <1.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,mjs}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 80
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tsup": "^8.5.1",
    "typebox": "1.3.16",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
